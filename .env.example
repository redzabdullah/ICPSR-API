# Copy this file to `.env` and fill in your real values once your
# UM API Directory app / ICPSR Object-Export access is approved.
# NEVER commit the real .env file (it's already in .gitignore).

# From the "API Keys" section of your App in the UM API Directory
ICPSR_API_KEY=
ICPSR_API_SECRET=

# Confirmed against ICPSR's public Postman collection
# ("Public Object Export Toolkit" -> Scripts -> Before request).
ICPSR_GATEWAY_URL=https://gw.api.it.umich.edu
ICPSR_API_PATH=icpsr/objectexport
ICPSR_OAUTH_PATH=um/oauth2/tokens
ICPSR_OAUTH_SCOPE=icpsr-objectexport
